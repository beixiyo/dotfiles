// Niri 配置 — https://niri-wm.github.io/niri/Configuration:-Introduction
// 保存即热重载，无需重启。验证语法：niri validate
// v25.11+ 支持 include 拆分配置，optional=true 文件不存在时不报错

include "layout.kdl"
include "blur.kdl"
include "rules.kdl"
include "animations.kdl"
include "binds.kdl"
include optional=true "output.kdl"

// Noctalia 官方 Niri 模板输出；文件未生成时可选 include 保持配置可用
include optional=true "noctalia.kdl"
include optional=true "nvidia.kdl"

input {
  keyboard {
    xkb {}
    numlock
    repeat-delay 250
    repeat-rate 35
  }

  touchpad {
    tap
    natural-scroll
    scroll-factor 0.3
    pinch-sensitivity 1.8
  }

  mouse {
    accel-profile "flat"
  }

  focus-follows-mouse max-scroll-amount="0%"
}

cursor {
  xcursor-theme "breeze_cursors"
  xcursor-size 24
  hide-after-inactive-ms 15000
}

prefer-no-csd

overview {
  zoom 0.5
}
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
  skip-at-startup
}

// Alt+Tab 窗口切换器（带缩略图）
recent-windows {
  debounce-ms 750
  open-delay-ms 150

  highlight {
    active-color "#999999ff"
    urgent-color "#ff9999ff"
    padding 30
    corner-radius 12
  }

  previews {
    max-height 480
    max-scale 0.2
  }

  binds {
    Alt+Tab         { next-window scope="workspace"; }
    Alt+Shift+Tab   { previous-window scope="workspace"; }
  }
}

environment {
  LANG "en_US.UTF-8"
  LC_CTYPE "en_US.UTF-8"
  LC_MESSAGES "zh_CN.UTF-8"
  LC_TIME "zh_CN.UTF-8"
  PATH "/usr/local/bin:/usr/bin:/bin:/home/dev/.local/bin"

  XMODIFIERS "@im=fcitx"
  QT_IM_MODULE "fcitx"
  QT_IM_MODULES "wayland;fcitx;ibus"

  GTK_THEME "MacTahoe-Dark"
  // 让 Qt 加载 KDE 平台主题插件，否则 kdeglobals 的深色配色不会套进 QPalette
  // Kvantum 只画深色背景、文字仍是浅色主题的黑色，导致 Dolphin 等 KDE 应用文字不可见
  QT_QPA_PLATFORMTHEME "kde"
  QT_STYLE_OVERRIDE "kvantum-dark"
}

// 自启动
// 检测 NVIDIA 驱动，生成/删除 nvidia.kdl（首次需重启 niri 生效）
spawn-at-startup "sh" "-c" "$HOME/.config/niri/scripts/detect-nvidia.sh"

// 自动登录后立即锁屏；Noctalia 不可用时由脚本回退 Hyprlock
spawn-sh-at-startup "~/.config/niri/scripts/lock.sh"

// 输入法使用 XDG autostart 生成的 unit，避免重复实例
spawn-at-startup "systemctl" "--user" "start" "app-org.fcitx.Fcitx5@autostart.service"

// Noctalia 提供桌面 Shell、Polkit、壁纸、剪贴板、OSD 与空闲管理
// XEmbed 桥为 Noctalia 转换旧协议托盘图标
spawn-at-startup "systemctl" "--user" "start" "plasma-xembedsniproxy.service"
