// Niri 配置 — https://niri-wm.github.io/niri/Configuration:-Introduction
// 保存即热重载，无需重启。验证语法：niri validate
// v25.11+ 支持 include 拆分配置，optional=true 文件不存在时不报错

include "layout.kdl"
include "blur.kdl"
include "rules.kdl"
include "animations.kdl"
include "binds.kdl"
include optional=true "output.kdl"

// 旧 Matugen 动态配色；已由 Noctalia 官方 Niri 模板替代
// include optional=true "colors.kdl"
// Noctalia 官方 Niri 模板输出；文件未生成时可选 include 保持配置可用
include optional=true "noctalia.kdl"
include optional=true "nvidia.kdl"

input {
  keyboard {
    xkb {}
    numlock
    repeat-delay 250
    repeat-rate 35
  }

  touchpad {
    tap
    natural-scroll
  }

  mouse {
    accel-profile "flat"
  }

  focus-follows-mouse max-scroll-amount="0%"
}

cursor {
  xcursor-theme "breeze_cursors"
  xcursor-size 24
  hide-after-inactive-ms 15000
}

prefer-no-csd

overview {
  zoom 0.5
}
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
  skip-at-startup
}

// Alt+Tab 窗口切换器（带缩略图）
recent-windows {
  debounce-ms 750
  open-delay-ms 150

  highlight {
    active-color "#999999ff"
    urgent-color "#ff9999ff"
    padding 30
    corner-radius 12
  }

  previews {
    max-height 480
    max-scale 0.2
  }

  binds {
    Alt+Tab         { next-window scope="workspace"; }
    Alt+Shift+Tab   { previous-window scope="workspace"; }
  }
}

environment {
  LANG "en_US.UTF-8"
  LC_CTYPE "en_US.UTF-8"
  LC_MESSAGES "zh_CN.UTF-8"
  LC_TIME "zh_CN.UTF-8"
  PATH "/usr/local/bin:/usr/bin:/bin:/home/dev/.local/bin"

  XMODIFIERS "@im=fcitx"
  QT_IM_MODULE "fcitx"
  QT_IM_MODULES "wayland;fcitx;ibus"

  GTK_THEME "MacTahoe-Dark"
  // 让 Qt 加载 KDE 平台主题插件，否则 kdeglobals 的深色配色不会套进 QPalette
  // Kvantum 只画深色背景、文字仍是浅色主题的黑色，导致 Dolphin 等 KDE 应用文字不可见
  QT_QPA_PLATFORMTHEME "kde"
  QT_STYLE_OVERRIDE "kvantum-dark"
}

// 自启动
// 检测 NVIDIA 驱动，生成/删除 nvidia.kdl（首次需重启 niri 生效）
spawn-at-startup "sh" "-c" "$HOME/.config/niri/scripts/detect-nvidia.sh"

// 自动登录后立即锁屏（SDDM 跳过了密码验证）
spawn-sh-at-startup "~/.config/niri/scripts/lock.sh"
// 旧 Hyprlock 登录锁屏（Noctalia 已接管，保留作回退）
// spawn-at-startup "hyprlock"
// 旧通知守护进程（已由 Noctalia 替代，保留作回退）
// spawn-at-startup "systemctl" "--user" "start" "mako.service"

// 输入法（XDG autostart 生成的 systemd user unit，避免重复实例）
spawn-at-startup "systemctl" "--user" "start" "app-org.fcitx.Fcitx5@autostart.service"
// Noctalia 已接管 Polkit 提权弹窗
// 旧 polkit-gnome agent（保留作回退）
// spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

// 旧壁纸链路（已由 Noctalia 的壁纸选择、轮播和取色替代，保留作回退）
// spawn-at-startup "awww-daemon"
// spawn-at-startup "awww-daemon" "-n" "overview"
// spawn-sh-at-startup "~/.config/niri/scripts/wallpaper-cycle.sh"

// 旧状态栏（已由 Noctalia 替代，保留作回退）
// spawn-at-startup "systemctl" "--user" "start" "waybar.service"
// XEmbed 托盘桥继续把旧协议图标转换为 StatusNotifierItem，交给 Noctalia 显示
spawn-at-startup "systemctl" "--user" "start" "plasma-xembedsniproxy.service"

// 旧剪贴板历史监听（已由 Noctalia 替代，保留作回退）
// ExecStart 在 user drop-in 中保留 -max-items 5000
// spawn-at-startup "systemctl" "--user" "start" "cliphist.service"

// 旧音量/亮度 OSD（已由 Noctalia 替代，保留作回退）
// spawn-at-startup "swayosd-server"

// 空闲管理已由 Noctalia 接管：15 分钟锁屏、17 分钟关显示器，不自动休眠。
// 旧 Swayidle 参数完整保留作回退：
//   lock         → loginctl lock-session 信号 → lock.sh 请求 Noctalia 锁屏
//   timeout 120  → 2 分钟无操作：若 LockedHint=yes 则关屏，否则跳过
//   timeout 900  → 15 分钟无操作：自动锁屏
//   timeout 1020 → 17 分钟无操作：强制关屏（兜底走开场景）
//   before-sleep → 休眠前请求 Noctalia 锁屏并等待 LockedHint=yes
//
//   lock.sh 保持幂等且普通回调不阻塞 Swayidle；Noctalia 不可用时回退 Hyprlock。
//   无 unlock 回调：SIGUSR1 的真实语义是「立刻进入 idle」（man swayidle），会当场
//                   重锁 + 黑屏；且 niri 解锁时自己 notify_activity 已重置计时
//   无 resume 回调：niri 收到输入自动亮屏，且避免 swayidle #193 竞态死锁
// spawn-at-startup "swayidle" "-w" "lock" "~/.config/niri/scripts/lock.sh" "timeout" "120" "loginctl show-session auto -p LockedHint --value 2>/dev/null | grep -qx yes && niri msg action power-off-monitors" "timeout" "900" "~/.config/niri/scripts/lock.sh" "timeout" "1020" "niri msg action power-off-monitors" "before-sleep" "~/.config/niri/scripts/lock.sh --wait"

// 旧 Hyprlock-only Swayidle 参数（Noctalia 已接管，保留作回退）
// spawn-at-startup "swayidle" "-w" "lock" "~/.config/niri/scripts/lock.sh" "timeout" "120" "pidof hyprlock && niri msg action power-off-monitors" "timeout" "900" "~/.config/niri/scripts/lock.sh" "timeout" "1020" "niri msg action power-off-monitors" "before-sleep" "~/.config/niri/scripts/lock.sh --wait"

// 默认应用（按需启动）
// spawn-at-startup "ghostty"
// spawn-at-startup "firefox"
