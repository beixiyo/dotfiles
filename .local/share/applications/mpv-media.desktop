[Desktop Entry]
Type=Application
Name=mpv (Images & Videos)
GenericName=Media Player
Icon=mpv
TryExec=mpv
Exec=mpv --player-operation-mode=pseudo-gui --image-display-duration=inf --autocreate-playlist=same -- %U
